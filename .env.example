# =============================================================================
# DevSecOps Agent Configuration
# =============================================================================
# Copy to .env and fill in your values. NEVER commit .env to version control.

# =============================================================================
# LLM Provider Selection
# =============================================================================
# Choose your LLM provider: gemini (FREE!) or openai (paid)
LLM_PROVIDER=gemini

# =============================================================================
# Gemini Configuration (FREE! - Recommended)
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT=120

# =============================================================================
# OpenAI Configuration (Paid - Alternative)
# =============================================================================
OPENAI_API_KEY=

# Chat model for generating reviews (default: gpt-4o-mini)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Embedding model for RAG (default: text-embedding-3-small)
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Custom API base URL (for Azure OpenAI, proxies, etc.)
# OPENAI_BASE_URL=

# API timeout in seconds (default: 120)
OPENAI_TIMEOUT=120

# Max retry attempts for API calls (default: 3)
OPENAI_MAX_RETRIES=3

# =============================================================================
# RAG Configuration
# =============================================================================
# Vector store persistence path (default: .devsecops/chroma)
DEVSECOPS_CHROMA_PATH=.devsecops/chroma

# Chroma collection name (default: devsecops_policies)
DEVSECOPS_CHROMA_COLLECTION=devsecops_policies

# Text chunk size for indexing (default: 1200)
RAG_CHUNK_SIZE=1200

# Overlap between chunks (default: 200)
RAG_CHUNK_OVERLAP=200

# =============================================================================
# GitHub Configuration (REQUIRED for webhook)
# =============================================================================
# GitHub Personal Access Token or Fine-grained token
# Permissions needed: Pull requests (read), Issues (write), Metadata (read)
GITHUB_TOKEN=

# Webhook secret (must match GitHub webhook configuration)
GITHUB_WEBHOOK_SECRET=

# GitHub API URL (default: https://api.github.com)
# For GitHub Enterprise Server, use: https://github.example.com/api/v3
GITHUB_API_URL=https://api.github.com

# =============================================================================
# Webhook Server Configuration
# =============================================================================
# Server bind address (default: 0.0.0.0)
WEBHOOK_HOST=0.0.0.0

# Server port (default: 8080)
PORT=8080

# Allow unsigned webhooks (DEV ONLY - default: false)
WEBHOOK_ALLOW_UNSIGNED=false

# PR actions to process (default: opened,synchronize,reopened)
WEBHOOK_PR_ACTIONS=opened,synchronize,reopened

# Enable RAG for webhook reviews (default: false)
WEBHOOK_USE_RAG=false

# Top-K chunks to retrieve (default: 6)
WEBHOOK_RAG_K=6

# Default language hint (optional)
# WEBHOOK_DEFAULT_LANGUAGE=Python 3.11

# Additional context for reviews (optional)
# WEBHOOK_REVIEW_CONTEXT=Production service; PII may be present.

# Review mode: comprehensive (all aspects), security (vulnerabilities only),
# architecture (code quality), infrastructure (DevOps/cloud) - default: comprehensive
WEBHOOK_REVIEW_MODE=comprehensive

# Prompt style: detailed (thorough, most tokens), compact (50% fewer), ultra (86% fewer)
# Recommended: ultra for best token efficiency with maintained quality
WEBHOOK_PROMPT_STYLE=ultra

# Max diff size in characters (default: 500000)
WEBHOOK_MAX_DIFF_CHARS=500000

# Post comment on review failure (default: false)
WEBHOOK_POST_ON_FAILURE=false

# =============================================================================
# Rate Limiting
# =============================================================================
# Enable rate limiting (default: true)
RATE_LIMIT_ENABLED=true

# Max requests per minute per IP (default: 10)
RATE_LIMIT_PER_MINUTE=10

# =============================================================================
# Monitoring & Logging
# =============================================================================
# Logging level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable Prometheus metrics (default: true)
ENABLE_METRICS=true

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=

# =============================================================================
# Redis/Queue Configuration (Optional)
# =============================================================================
# Redis URL for job queue (optional)
# REDIS_URL=redis://localhost:6379/0

# Use Redis queue instead of FastAPI BackgroundTasks (default: false)
USE_BACKGROUND_QUEUE=false

# =============================================================================
# Cost Management
# =============================================================================
# Max tokens per request (default: 16000)
MAX_TOKENS_PER_REQUEST=16000

# Enable cost tracking (default: true)
ENABLE_COST_TRACKING=true

# =============================================================================
# Production Settings
# =============================================================================
# For production deployments, also consider:
# - Using secrets management (AWS Secrets Manager, Azure Key Vault, etc.)
# - Enabling HTTPS with reverse proxy (nginx, Caddy)
# - Setting up monitoring (Prometheus, Grafana)
# - Configuring log aggregation (ELK, Datadog, CloudWatch)
# - Implementing backup strategy for Chroma index
